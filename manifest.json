{
  "manifest_version": 2,
  "name": "__MSG_extName__",
  "description": "__MSG_extDescription__",
  "version": "2.1.0",
  "author": "Jake Hartz (original), ported 2026",
  "homepage_url": "https://github.com/darvodelecbg/thunderbird-open-in-conversation",
  "default_locale": "en",
  "browser_specific_settings": {
    "gecko": {
      "id": "open_in_conversation@hartz.io",
      "strict_min_version": "128.0"
    }
  },
  "background": {
    "scripts": ["background.js"]
  },
  "options_ui": {
    "page": "options.html",
    "browser_style": true
  },
  "commands": {
    "open-conversation": {
      "suggested_key": { "default": "Ctrl+Shift+O" },
      "description": "__MSG_cmdOpenConversation__"
    }
  },
  "experiment_apis": {
    "openInConversation": {
      "schema": "api/schema.json",
      "parent": {
        "scopes": ["addon_parent"],
        "paths": [["openInConversation"]],
        "script": "api/implementation.js"
      }
    }
  }
}
